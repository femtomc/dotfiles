[Desktop Entry]
Name=Terminal Sessions
Comment=Manage Claude Code, Codex, and Ghostty terminal sessions
Type=Application
Exec=cosmic-ext-applet-sessions
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Terminal;Sessions;Claude;Codex;Ghostty;
