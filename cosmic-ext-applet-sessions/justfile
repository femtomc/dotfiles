name := "cosmic-ext-applet-sessions"
appid := "dev.femtomc.CosmicExtAppletSessions"
prefix := "/usr"

bin-src := "target/release" / name
bin-dst := prefix / "bin" / name

desktop-src := "res" / appid + ".desktop"
desktop-dst := prefix / "share" / "applications" / appid + ".desktop"

icon-src := "res" / appid + "-symbolic.svg"
icon-dst := prefix / "share" / "icons" / "hicolor" / "scalable" / "apps" / appid + "-symbolic.svg"

default: build-release

build-release:
    cargo build --release

install:
    install -Dm0755 {{bin-src}} {{bin-dst}}
    install -Dm0644 {{desktop-src}} {{desktop-dst}}
    install -Dm0644 {{icon-src}} {{icon-dst}}

uninstall:
    rm -f {{bin-dst}}
    rm -f {{desktop-dst}}
    rm -f {{icon-dst}}
